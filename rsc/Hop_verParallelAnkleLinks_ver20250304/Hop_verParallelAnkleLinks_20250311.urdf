<robot name="DHAL" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
    </material>
    <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
    </material>
    <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="silver">
        <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
    </material>
    <material name="brown">
        <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
    </material>
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <link name="Thigh">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Thigh_with_Link_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 -0.04 -0.14"/>
            <geometry>
                <box size="0.1 0.02 0.26"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="0 0.06 -0.14"/>
            <geometry>
                <box size="0.1 0.06 0.26"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0.001815 0.027609 -0.115412"/>
            <mass value="4.29025"/>
            <inertia ixx="0.077120" ixy="-0.000030" ixz="-0.001298" iyy="0.076206" iyz="-0.012889" izz="0.014845"/>
        </inertial>
    </link>

    <joint name="00_knee_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 -0.2523"/>
        <parent link="Thigh"/>
        <child link="Calf"/>
        <axis xyz="0 1 0"/>
        <dynamics rotor_inertia="0.36880" damping="0" friction="0"/>
        <limit effort="600.0" velocity="10.11" lower="0" upper="2.26893"/> <!--65.1V based-->
    </joint>
    <link name="Calf">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 -0.205"/>
            <geometry>
                <box size="0.1 0.048 0.32"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0.001730 0.000040 -0.146153"/>
            <mass value="3.38378"/>
            <inertia ixx="0.104136" ixy="0.000004" ixz="-0.000722" iyy="0.106810" iyz="-0.000750" izz="0.004357"/>
        </inertial>
    </link>

    <joint name="01_ankle_pitch_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 -0.41"/>
        <parent link="Calf"/>
        <child link="Universal"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.872665" upper="0.698132"/>
    </joint>
    <link name="Universal">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Universal_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.209567"/>
            <inertia ixx="0.00048" ixy="0" ixz="0" iyy="0.000089" iyz="0" izz="0.000124"/>
        </inertial>
    </link>

    <joint name="02_ankle_roll_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="Universal"/>
        <child link="Foot"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.523599" upper="0.523599"/>
    </joint>
    <link name="Foot">
<!--        <visual>-->
<!--            <origin rpy="0 0 0" xyz="0 0 0"/>-->
<!--            <geometry>-->
<!--                <mesh filename="URDF_Foot_verHopping1_Simplified.dae" scale="1 1 1"/>-->
<!--            </geometry>-->
<!--            <material name="grey"/>-->
<!--        </visual>-->
<!--        <collision>-->
<!--            <origin rpy="0 0 0" xyz="0 0 -0.065"/>-->
<!--            <geometry>-->
<!--&lt;!&ndash;                <box size="0.24 0.08 0.03"/>&ndash;&gt;-->
<!--                <box size="0.265 0.10 0.03"/>-->
<!--            </geometry>-->
<!--        </collision>-->
<!--        <inertial>-->
<!--            <origin rpy="0 0 0" xyz="-0.014103 -0.0000 -0.044208"/>-->
<!--&lt;!&ndash;            <mass value="0.899532"/>&ndash;&gt;-->
<!--            <mass value="1.0"/>-->
<!--&lt;!&ndash;            <inertia ixx="0.002914" ixy="0.000001" ixz="0.000081" iyy="0.005654" iyz="0" izz="0.003715"/>&ndash;&gt;-->
<!--            <inertia ixx="0.0032" ixy="0.000001" ixz="0.0001" iyy="0.005654" iyz="0" izz="0.0040"/>-->
<!--        </inertial>-->
        <visual>
            <origin rpy="0 0 0" xyz="-0.02 0 -0.065"/>
            <geometry>
                <box size="0.20 0.1 0.03"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <visual>
            <origin rpy="0 -0.5 0" xyz="0.12 0 -0.045"/>
            <geometry>
                <box size="0.06 0.1 0.03"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.02 0 -0.065"/>
            <geometry>
                <box size="0.20 0.1 0.03"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 -0.5 0" xyz="0.12 0 -0.045"/>
            <geometry>
                <box size="0.06 0.1 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0.003088 -0.0000 -0.044077"/>
            <mass value="1.205532"/>
            <inertia ixx="0.003946" ixy="0.000001" ixz="-0.000434" iyy="0.008954" iyz="0" izz="0.006827"/>
        </inertial>
    </link>

    <joint name="03_left_ankle_link_pitch_joint" type="continuous">
        <origin rpy="0 0 0" xyz="-0.0640125 0.04 0.0112871"/>
        <parent link="Foot"/>
        <child link="Left_Dice"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="Left_Dice">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_Link_Dice_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.037914"/>
            <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000004"/>
        </inertial>
    </link>

    <joint name="04_left_ankle_link_roll_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="Left_Dice"/>
        <child link="Left_Ankle_Link"/>
        <axis xyz="1 0 0"/>
    </joint>
    <link name="Left_Ankle_Link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_Link_S_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0.000021 0 0.083422"/>
            <mass value="0.134342"/>
            <inertia ixx="0.001708" ixy="0" ixz="0" iyy="0.001714" iyz="0" izz="0.000010"/>
        </inertial>
    </link>

    <joint name="05_right_ankle_link_pitch_joint" type="continuous">
        <origin rpy="0 0 0" xyz="-0.0640125 -0.04 0.0112871"/>
        <parent link="Foot"/>
        <child link="Right_Dice"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="Right_Dice">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_Link_Dice_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.037914"/>
            <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000004"/>
        </inertial>
    </link>

    <joint name="06_right_ankle_link_roll_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="Right_Dice"/>
        <child link="Right_Ankle_Link"/>
        <axis xyz="1 0 0"/>
    </joint>
    <link name="Right_Ankle_Link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_Link_L_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0.000017 0 0.137377"/>
            <mass value="0.170375"/>
            <inertia ixx="0.005596" ixy="0" ixz="0" iyy="0.005602" iyz="0" izz="0.000011"/>
        </inertial>
    </link>

    <joint name="07_left_ankle_link_input_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0 0.0255 -0.205"/>
        <parent link="Calf"/>
        <child link="Left_Ankle_Link_Input"/>
        <axis xyz="0 1 0"/>
        <dynamics rotor_inertia="0.0128" damping="0" friction="0"/>
        <limit effort="150.0" velocity="18.3"/> <!--65.1V based-->
    </joint>
    <link name="Left_Ankle_Link_Input">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_Link_Input_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="green"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0.022550 0.012714 -0.001469"/>
            <mass value="0.132288"/>
            <inertia ixx="0.000048" ixy="0.000048" ixz="0" iyy="0.000170" iyz="-0.000004" izz="0.000187"/>
        </inertial>
    </link>

    <joint name="08_right_ankle_link_input_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0 -0.0255 -0.09"/>
        <parent link="Calf"/>
        <child link="Right_Ankle_Link_Input"/>
        <axis xyz="0 1 0"/>
        <dynamics rotor_inertia="0.0128" damping="0" friction="0"/>
        <limit effort="150.0" velocity="18.3"/> <!--65.1V based-->
    </joint>
    <link name="Right_Ankle_Link_Input">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_Link_Input_mir_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="green"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0.022550 -0.012714 -0.001469"/>
            <mass value="0.132288"/>
            <inertia ixx="0.000048" ixy="-0.000048" ixz="0" iyy="0.000170" iyz="0.000004" izz="0.000187"/>
        </inertial>
    </link>

    <joint name="09_temp_weight_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.1"/>
        <parent link="Thigh"/>
        <child link="Temp_Weight"/>
    </joint>
    <link name="Temp_Weight">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0.046728"/>
            <mass value="3.17388"/>
            <inertia ixx="0.010710" ixy="0" ixz="0" iyy="0.010709" iyz="0" izz="0.005796"/>
        </inertial>
    </link>

        <!-- link length: 198 mm, 316 mm-->
        <!--    <constraints nominal_config="0.0, 0.0, 0.8, 0.99619470, 0.0, -0.08715574, 0.0,  0.349066, -0.174533, 0.0,  0.786794, 0.00244346, 0.574911, 0.00157080,  0.722043, 0.462338">-->
        <!-- link length: 200 mm, 319 mm-->
    <constraints nominal_config="0.0, 0.0, 0.8, 0.99619470, 0.0, -0.08715574, 0.0,  0.349066, 0.0, 0.0,  0.641723, -0.002499, 0.409439, 0.001567, 0.541459, 0.249985">
        <!-- link length: 201 mm, 320 mm-->
        <!--    <constraints nominal_config="0.0, 0.0, 0.8, 0.99619470, 0.0, -0.08715574, 0.0,  0.349066, 0.0, 0.0,     0.641183,  -0.002487,   0.408911,   0.001562,   0.525985,   0.234384">-->
        <pin body1="Left_Ankle_Link_Input" body2="Left_Ankle_Link" anchor="0.065 0.015 0.0"/>
        <pin body1="Right_Ankle_Link_Input" body2="Right_Ankle_Link" anchor="0.065 -0.015 0.0"/>
    </constraints>

</robot>
