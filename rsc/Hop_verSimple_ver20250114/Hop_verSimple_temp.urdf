<robot name="DHAL" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
    </material>
    <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
    </material>
    <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="silver">
        <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
    </material>
    <material name="brown">
        <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
    </material>
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <link name="Thigh">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Thigh_with_Link_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 -0.04 -0.14"/>
            <geometry>
                <box size="0.1 0.02 0.26"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="0 0.06 -0.14"/>
            <geometry>
                <box size="0.1 0.06 0.26"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0.001815 0.027609 -0.115412"/>
            <mass value="4.157590"/>
            <inertia ixx="0.077120" ixy="-0.000030" ixz="-0.001298" iyy="0.076206" iyz="-0.012889" izz="0.014845"/>
        </inertial>
    </link>

    <joint name="00_knee_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 -0.2523"/>
        <parent link="Thigh"/>
        <child link="Calf"/>
        <axis xyz="0 1 0"/>
        <limit effort="600.0" velocity="9.0" lower="0" upper="2.26893"/>
    </joint>
    <link name="Calf">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_with_Link_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 -0.205"/>
            <geometry>
                <box size="0.1 0.048 0.32"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0.000591 -0.000359 -0.160841"/>
            <mass value="4.035068"/>
            <inertia ixx="0.149211" ixy="-0.000002" ixz="0.002787" iyy="0.152336" iyz="-0.001299" izz="0.006886"/>
        </inertial>
    </link>

    <joint name="01_ankle_pitch_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 -0.41"/>
        <parent link="Calf"/>
        <child link="Universal"/>
        <axis xyz="0 1 0"/>
        <limit effort="200.0" velocity="9.0" lower="-0.872665" upper="0.698132"/>
    </joint>
    <link name="Universal">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Universal_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.209567"/>
            <inertia ixx="0.00048" ixy="0" ixz="0" iyy="0.000089" iyz="0" izz="0.000124"/>
        </inertial>
    </link>

    <joint name="02_ankle_roll_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="Universal"/>
        <child link="Foot"/>
        <axis xyz="1 0 0"/>
        <limit effort="200.0" velocity="9.0" lower="-0.523599" upper="0.523599"/>
    </joint>
    <link name="Foot">
<!--        <visual>-->
<!--            <origin rpy="0 0 0" xyz="0 0 0"/>-->
<!--            <geometry>-->
<!--                <mesh filename="URDF_Foot_verHopping1_Simplified.dae" scale="1 1 1"/>-->
<!--            </geometry>-->
<!--            <material name="grey"/>-->
<!--        </visual>-->
        <visual>
            <origin rpy="0 0 0" xyz="-0.02 0 -0.065"/>
            <geometry>
                <!--                <box size="0.24 0.8 0.03"/>-->
                <box size="0.20 0.1 0.03"/>
            </geometry>
            <material name="white"/>
        </visual>
        <visual>
            <origin rpy="0 -0.5 0" xyz="0.12 0 -0.045"/>
            <geometry>
                <box size="0.06 0.1 0.03"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.02 0 -0.065"/>
            <geometry>
<!--                <box size="0.24 0.8 0.03"/>-->
                <box size="0.20 0.1 0.03"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 -0.5 0" xyz="0.12 0 -0.045"/>
            <geometry>
                <box size="0.06 0.1 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="-0.019703 -0.000021 -0.036108"/>
            <mass value="0.547532"/>
            <inertia ixx="0.001484" ixy="0.000001" ixz="-0.000019" iyy="0.003208" iyz="0" izz="0.002160"/>
        </inertial>
    </link>

    <joint name="03_temp_weight_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.1"/>
        <parent link="Thigh"/>
        <child link="Temp_Weight"/>
    </joint>
    <link name="Temp_Weight">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
        </inertial>
    </link>

</robot>
