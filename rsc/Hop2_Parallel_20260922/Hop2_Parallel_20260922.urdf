<robot name="DHAL" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--
      CURRENT CALIBRATED MODEL (2026-09-21): total link mass = 14.000 kg.
      User-requested global proportional distribution of unresolved mass:
      baseline total = 13.187198673293 kg; residual = 0.812801326707 kg;
      every link mass and all six COM-centered inertia entries are multiplied
      by 1.0616356321644795439547563032018071123483308513041.
      COM positions and inertial-frame orientations are unchanged.
      Physical-source comments below describe the PRE-NORMALIZATION baseline;
      effective link masses include the globally allocated residual, even for
      links whose baseline masses were measured. This is an assumed distribution.
      Joint rotor_inertia is unchanged; no separate D110 +46 g is added.
      Original measurements, baseline URDF, algorithm, and checks are retained
      in calibration/. See README_CURRENT_20260921.md for current model status.
      Remaining local provisional assumptions are not resolved by total-mass matching.
    -->
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
    </material>
    <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
    </material>
    <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="silver">
        <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
    </material>
    <material name="brown">
        <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
    </material>
    <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
    </material>
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <link name="Thigh">
        <!-- LEGACY baseline distribution: Thigh repartition remains pending.
             2026-09-16: received input assembly, long link, six M5 bolts,
             two output-fixed CUG pins, and YT2015 bearing properties.
             Reported assembly poses differ from the earlier STEP reference;
             CUG4-10 <2> duplicated <3>, now corrected by the user;
             physical output pins are <3>/<4> (2.10 g total).
             Reconcile poses and rigid-body boundaries before repartition.
             See calibration/thigh_partition_20260916.json and .md.
             This historical partition note does not supply new baseline values. -->
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Thigh_with_Link_verHopping1_Simplified.dae" scale="1 1 1"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 -0.04 -0.14"/>
            <geometry>
                <box size="0.1 0.02 0.26"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="0 0.06 -0.14"/>
            <geometry>
                <box size="0.1 0.06 0.26"/>
            </geometry>
        </collision>
        <!-- GLOBAL MASS NORMALIZATION 2026-09-21: baseline mass 4.29025 kg; effective mass 4.554682270893658363 kg.
             All six COM-centered inertia entries scaled by the common factor. -->
        <inertial>
            <origin rpy="0 0 0" xyz="0.001815 0.027609 -0.115412"/>
            <mass value="4.554682270893658363"/>
            <inertia ixx="0.081873339952524662429791" ixy="-0.000031849068964934386319" ixz="-0.001378003050549494448053" iyy="0.080903004984726328126616" iyz="-0.013683421662967976842033" izz="0.015759980959481698830008"/>
        </inertial>
    </link>

    <joint name="00_knee_joint" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 -0.2523"/>
        <parent link="Thigh"/>
        <child link="Calf"/>
        <axis xyz="0 1 0"/>
        <!-- PROVISIONAL D151 output-axis equivalent inertia:
             motor/sun/encoder ring and two sun-locking LPSTAG pins at 20x;
             carrier, four carrier-locking LPSTAG pins, and eight carrier-fixed
             fasteners (4x M3_10 + 4x M4_12) at 5x;
             four compound planets (26.4 mm orbit at 5x and spin at -10x),
             the clean three-part output group and two output-fixed LPSTAG pins
             at 1x, and the exact orbital term of eight MTA planet bearings at 5x.
             Bearing race/cage/ball self-rotation and remaining output-side fasteners
             remain pending; the mixed 201.80 g 4-C selection is excluded. -->
        <dynamics rotor_inertia="0.37825873418" damping="0" friction="0"/>
        <!-- PROVISIONAL measured motor-side envelope: the static test reached
             27.5166 N*m (mean absolute CW/CCW endpoint) at 110 A and stopped
             before the true peak. effort=550.3 N*m uses 27.5166*20 without
             gearbox-efficiency derating;
             velocity=10.11 rad/s retains the 65.1 V estimate pending speed/Kv data. -->
        <limit effort="550.3" velocity="10.11" lower="0" upper="2.26893"/>
    </joint>
    <link name="Calf">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="URDF_Calf_verHopping1_Simplified.dae" scale="1 1 1"/>
