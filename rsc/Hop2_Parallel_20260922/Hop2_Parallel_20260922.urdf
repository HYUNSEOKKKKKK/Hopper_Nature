        <!-- GLOBAL MASS NORMALIZATION 2026-09-21: baseline mass 3.419690 kg; effective mass 3.630464754956549052 kg.
             All six COM-centered inertia entries scaled by the common factor. -->
        <inertial>
            <origin rpy="0 0 0" xyz="0.003950 0.000010 -0.144090"/>
