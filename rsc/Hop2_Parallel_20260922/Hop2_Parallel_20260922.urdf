            <inertia ixx="0.033378934915984182053857" ixy="-0.000001623155950728916064" ixz="-0.000798941007944114582816" iyy="0.036660119700712617369368" iyz="0.000911935846113782348799" izz="0.005036075873680319866446"/>
        </inertial>
    </link>

