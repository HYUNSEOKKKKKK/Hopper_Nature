<?xml version="1.0" encoding="utf-8"?>
<!-- Stage-2 onboard camera for the hopper: RGB + aligned Depth, forward-down.
     Mass is ~0 on purpose: the camera link must NOT change the validated robot dynamics
     (the frozen Stage-1 policy must see the same robot). Rendered only on demand (getImage),
     so it adds zero overhead during Stage-1 training. -->
<sensor_set name="hopper_cam">
    <link>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1e-4"/>
            <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.02 0.06 0.02"/></geometry>
            <material name=""><color rgba="0.05 0.05 0.05 1"/></material>
        </visual>
        <sensor name="color" type="rgb" update_rate="30">
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
            <camera horizontal_fov="1.2">
                <image width="640" height="480"/>
                <clip near="0.03" far="4.0"/>
                <noise type="gaussian" mean="0.0" stddev="0.0"/>
            </camera>
        </sensor>
        <sensor name="depth" type="depth" update_rate="30">
            <data type="coordinates"/>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
            <camera horizontal_fov="1.2">
                <image width="640" height="480"/>
                <clip near="0.03" far="4.0"/>
                <noise type="gaussian" mean="0.0" stddev="0.0"/>
            </camera>
        </sensor>
    </link>
</sensor_set>
